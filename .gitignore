# ----------------------------------
# Ignorar archivos de Python / Django
# ----------------------------------
# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.env/
.env.*           # otros archivos de entorno con variables

# Paquetes y artefactos
*.egg-info/
dist/
build/
eggs/

# Configuración local de Django
*.sqlite3       # base de datos SQLite local
staticfiles/    # carpeta de collectstatic local (si la generas en el repo)
media/          # si guardas uploads localmente

# Logs y cachés
*.log
*.pot
*.pytest_cache/
coverage.xml
htmlcov/

# ----------------------------------
# Ignorar archivos de Docker
# ----------------------------------
# Overrides locales de Compose
docker-compose.override.yml
.env.docker*    # variables de entorno específicas de Docker

# Runtime de contenedores
docker-compose.*.local.yml
docker-compose.*.env

# ----------------------------------
# Ignorar Node / npm / Vue.js
# ----------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Carpeta de build de Vue
dist/
public/

# Lockfiles (opcional si no quieres trackearlos)
package-lock.json
yarn.lock

# ----------------------------------
# Ignorar archivos de editor/IDE
# ----------------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ----------------------------------
# Misc
# ----------------------------------
.DS_Store
Thumbs.db
